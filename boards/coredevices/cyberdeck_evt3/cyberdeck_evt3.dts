/dts-v1/;

#include <nordic/nrf52840_qiaa.dtsi>
#include <nordic/nrf52840_partition.dtsi>
#include "cyberdeck_evt3-pinctrl.dtsi"

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/sensor/lsm6dso.h>

/ {
	model = "Core Devices Cyberdeck EVT3";
	compatible = "coredevices,cyberdeck-evt3";

	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,display = &ls013b7dh01;
		zephyr,led-strip = &rgb_led;
	};

	aliases {
		flash0 = &w25q256jw;
		light0 = &opt3001;
		imu0 = &lsm6dso;
		haptic0 = &drv2604;
	};

	cyberdeck_hwv: cyberdeck-hwv {
		compatible = "coredevices,cyberdeck-hwv";
		peripheral-power-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		lcd-select-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;
		ec-key-gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};

	lcd_backlight: lcd-backlight {
		compatible = "gpio-leds";
		lcd_backlight_led: lcd-backlight-led {
			gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
			label = "LCD backlight";
		};
	};

	kbd_backlight: kbd-backlight {
		compatible = "pwm-leds";
		kbd_backlight_led: kbd-backlight-led {
			pwms = <&pwm0 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
			label = "Q20 keyboard backlight";
		};
	};

	rgb_led: ws2812 {
		compatible = "worldsemi,ws2812-gpio";
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
		reset-delay = <50>;
		gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
	};
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";

	peripheral_power_hog: peripheral-power-hog {
		gpio-hog;
		gpios = <10 GPIO_ACTIVE_HIGH>;
		output-high;
	};

	lcd_select_hog: lcd-select-hog {
		gpio-hog;
		gpios = <5 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&sw_pwm {
	status = "okay";
	generator = <&rtc2>;
	channel-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	da7212: audio-codec@1a {
		compatible = "renesas,da7212";
		reg = <0x1a>;
	};

	ofn83: optical-navigation@33 {
		compatible = "coredevices,ofn83";
		reg = <0x33>;
		int-gpios = <&gpio1 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		reset-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
		shutdown-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
	};

	tca8418: keyboard@34 {
		compatible = "coredevices,tca8418";
		reg = <0x34>;
		int-gpios = <&gpio1 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};

	opt3001: light-sensor@44 {
		compatible = "ti,opt3001";
		reg = <0x44>;
	};

	drv2604: haptic@5a {
		compatible = "ti,drv2604";
		reg = <0x5a>;
		en-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
	};

	lsm6dso: imu-sensor@6a {
		compatible = "st,lsm6dso";
		reg = <0x6a>;
		irq-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
		accel-pm = <LSM6DSO_DT_XL_ULP_MODE>;
		gyro-pm = <LSM6DSO_DT_GY_NORMAL_MODE>;
	};
};

&i2s0 {
	compatible = "nordic,nrf-i2s";
	status = "okay";
	pinctrl-0 = <&i2s0_default>;
	pinctrl-1 = <&i2s0_sleep>;
	pinctrl-names = "default", "sleep";
};

&qspi {
	status = "okay";
	pinctrl-0 = <&qspi_default>;
	pinctrl-1 = <&qspi_sleep>;
	pinctrl-names = "default", "sleep";

	w25q256jw: memory@0 {
		compatible = "nordic,qspi-nor";
		reg = <0>;
		writeoc = "pp4o";
		readoc = "read4io";
		sck-frequency = <8000000>;
		quad-enable-requirements = "S2B1v6";
		address-size-32;
		enter-4byte-addr = <0xb7>;
		jedec-id = [ef 60 19];
		size-in-bytes = <0x02000000>;
		has-dpd;
		t-enter-dpd = <3000>;
		t-exit-dpd = <20000>;
	};
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	cs-gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";
	zephyr,pm-device-runtime-auto;

	ls013b7dh01: display@0 {
		compatible = "sharp,ls013b7dh01";
		reg = <0>;
		disp-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		pwms = <&sw_pwm 0 PWM_HZ(120) PWM_POLARITY_NORMAL>;
		pwm-names = "extcomin";
		spi-max-frequency = <1000000>;
		backlight = <&lcd_backlight>;
		height = <240>;
		width = <400>;
		initially-on;
	};
};

&uicr {
	gpio-as-nreset;
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
